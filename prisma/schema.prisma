// Docs: https://pris.ly/d/prisma-schema
// Generate client: npx prisma generate
// Update db w/ migrations: npx prisma migrate dev --name <name>
// Push scheme w/o migrations: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProjectType {
  CHARACTER
  CLOTHING
  OBJECT
  IMAGE_STYLE
  CONCEPT
  OTHER
}

model Project {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  slug      String      @unique
  type      ProjectType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  images Image[]
}

enum ImageStatus {
  PENDING_INDEXING
  INDEXING
  INDEXED
  INDEXING_FAILED
  DELETED_DUPLICATE
  DELETED_OTHER
}

model Image {
  id                  Int         @id @default(autoincrement())
  projectId           Int
  extension           String
  originalWidth       Int
  originalHeight      Int
  originalFileSize    Int
  originalAspectRatio Float
  width               Int
  height              Int
  fileSize            Int
  aspectRatio         Float
  hash                String // For duplicate detection.
  embedding           Bytes // Vector embedding data (if available).
  editData            Json? // { x, y, rotation, width, height }
  rating              Int?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  status              ImageStatus @default(PENDING_INDEXING)

  // Relations
  project        Project          @relation(fields: [projectId], references: [id])
  DuplicateImage DuplicateImage[]
}

enum DuplicateStatus {
  PENDING_REVIEW // Waiting for user decision
  IGNORED // User marked as "not duplicate"
  RESOLVED // User took action (deleted some images)
}

model DuplicateGroup {
  id        Int             @id @default(autoincrement())
  projectId Int
  hash      String // The hash that matched between images
  status    DuplicateStatus @default(PENDING_REVIEW)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Relations
  images DuplicateImage[]
}

model DuplicateImage {
  id               Int      @id @default(autoincrement())
  duplicateGroupId Int
  imageId          Int
  wasDeleted       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  duplicateGroup DuplicateGroup @relation(fields: [duplicateGroupId], references: [id])
  image          Image          @relation(fields: [imageId], references: [id])

  @@unique([duplicateGroupId, imageId])
}
